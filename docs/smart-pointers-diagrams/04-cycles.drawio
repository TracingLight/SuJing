<mxfile host="app.diagrams.net"><diagram name="04｜环里还有所有者，引用计数就不会归零" id="04-cycles"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="04｜环里还有所有者，引用计数就不会归零" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=43;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="44" y="30" width="1512" height="108" as="geometry" /></mxCell><mxCell id="3" value="错误：两个方向都表达拥有" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="70" y="215" width="670" height="65" as="geometry" /></mxCell><mxCell id="4" value="对象 A&#10;强计数 = 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f9dedb;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="90" y="380" width="260" height="170" as="geometry" /></mxCell><mxCell id="5" value="对象 B&#10;强计数 = 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f9dedb;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="480" y="380" width="260" height="170" as="geometry" /></mxCell><mxCell id="6" value="" edge="1" parent="1" style="endArrow=block;strokeWidth=3;strokeColor=#29343d;dashed=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="415" as="sourcePoint" /><mxPoint x="480" y="415" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7" value="shared" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="335" y="330" width="160" height="65" as="geometry" /></mxCell><mxCell id="8" value="" edge="1" parent="1" style="endArrow=block;strokeWidth=3;strokeColor=#29343d;dashed=0;"><mxGeometry relative="1" as="geometry"