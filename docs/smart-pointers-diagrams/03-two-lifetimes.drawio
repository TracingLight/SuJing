<mxfile host="app.diagrams.net"><diagram name="03｜对象先结束，控制块可以后结束" id="03-two-lifetimes"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="03｜对象先结束，控制块可以后结束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=43;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="44" y="30" width="1512" height="108" as="geometry" /></mxCell><mxCell id="3" value="① 强 = 1，弱观察者 = 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceefa;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="65" y="250" width="450" height="85" as="geometry" /></mxCell><mxCell id="4" value="② 强 = 0，弱观察者 = 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8e1f5;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="575" y="250" width="450" height="85" as="geometry" /></mxCell><mxCell id="5" value="③ 强 = 0，弱观察者 = 0" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceee3;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1085" y="250" width="450" height="85" as="geometry" /></mxCell><mxCell id="6" value="" edge="1" parent="1" style="endArrow=block;strokeWidth=3;strokeColor=#29343d;dashed=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="290" as="sourcePoint" /><mxPoint x="575" y="290" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7" value="" edge="1" parent="1" style="endArrow=block;strokeWidth=3;strokeColor=#29343d;dashed=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="1025" y="290" as="sourcePoint" /><mxPoint x="1085" y="290" as="targetPoint" /></mxGeometry></mxCell><mxCell id="8" value="对象：存活&#10;可以 lock() 获得所有权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceee3;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="65" y="395" width="450" height="145" as="geometry" /></mxCell><mxCell id="9" value="控制块：存活&#10;weak_ptr 还需要它" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="65" y="610" width="450" height="145" as="geometry" /></mxCell><mxCell id="10" value="对象：已析构&#10;lock() 返回空 shared_ptr" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f9dedb;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="575" y="395" width="450" height="145" as="geometry" /></mxCell><mxCell id="11" value="控制块：仍存活&#10;保留过期状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="575" y="610" width="450" height="145" as="geometry" /></mxCell><mxCell id="12" value="对象：早已析构&#10;不会被 lock() 复活" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f9dedb;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1085" y="395" width="450" height="145" as="geometry" /></mxCell><mxCell id="13" value="控制块：可释放&#10;已无共享管理需求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceee3;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1085" y="610" width="450" height="145" as="geometry" /></mxCell><mxCell id="14" value="最后一个强所有者释放 → 对象析构" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="460" y="780" width="600" height="65" as="geometry" /></mxCell><mxCell id="15" value="make_shared 合并分配时：对象已析构，不代表整块合并存储已经归还。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="60" y="890" width="1480" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>