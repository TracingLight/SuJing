<mxfile host="app.diagrams.net"><diagram name="05｜make_shared：合并分配，也有取舍" id="05-make-shared"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="05｜make_shared：合并分配，也有取舍" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=43;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="44" y="30" width="1512" height="108" as="geometry" /></mxCell><mxCell id="3" value="shared_ptr&lt;T&gt;(new T)" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=33;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="65" y="225" width="680" height="75" as="geometry" /></mxCell><mxCell id="4" value="make_shared&lt;T&gt;()" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=33;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="855" y="225" width="680" height="75" as="geometry" /></mxCell><mxCell id="5" value="对象 T&#10;独立存储" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceee3;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=31;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="75" y="360" width="290" height="175" as="geometry" /></mxCell><mxCell id="6" value="控制块&#10;独立存储" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceefa;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=31;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="445" y="360" width="290" height="175" as="geometry" /></mxCell><mxCell id="7" value="" edge="1" parent="1" style="endArrow=block;strokeWidth=3;strokeColor=#29343d;dashed=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="447" as="sourcePoint" /><mxPoint x="365" y="447" as="targetPoint" /></mxGeometry></mxCell><mxCell id="8" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="855" y="340" width="680" height="220" as="geometry" /></mxCell><mxCell id="9" value="控制块" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceefa;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="880" y="365" width="290" height="170" as="geometry" /></mxCell><mxCell id="10" value="对象 T" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceee3;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1220" y="365" width="290" height="170" as="geometry" /></mxCell><mxCell id="11" value="通常：对象分配 + 控制块分配&#10;强计数归零后，可单独归还对象存储" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="75" y="575" width="660" height="100" as="geometry" /></mxCell><mxCell id="12" value="通常：一次合并分配&#10;弱观察者存活时，合并存储可能保留" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#29343d;" parent="1" vertex="1"><mxGeometry x="860" y="575" width="670" height="100" as="geometry" /></mxCell><mxCell id="13" value="两条路径都必须正确处理构造失败&#10;控制块分配失败时，标准 shared_ptr 构造函数会清理传入的对象" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8e1f5;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="75" y="725" width="1460" height="100" as="geometry" /></mxCell><mxCell id="14" value="默认优先 make_shared；自定义删除器、类专用分配策略等需求需要单独考虑。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0b8;strokeColor=#29343d;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="60" y="890" width="1480" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>